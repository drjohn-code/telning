---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import AgeStrip from '../components/AgeStrip.astro';
import Series from '../components/Series.astro';
import Skills from '../components/Skills.astro';
import TadaBand from '../components/TadaBand.astro';
import SendEnding from '../components/SendEnding.astro';
import TrustBand from '../components/TrustBand.astro';
import EmailBlock from '../components/EmailBlock.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Header />
  <main id="main" tabindex="-1">
    <Hero />
    <AgeStrip />
    <Series />
    <Skills />
    <TadaBand />
    <SendEnding />
    <TrustBand />
    <EmailBlock />
  </main>
  <Footer />
</Base>

---
import Admin from '../../layouts/Admin.astro';
import { TEMPLATE_NAMES } from '../../../server/emails.js';
---
<Admin title="Emails" page="/admin/emails">
  <section class="ad-card"><h2>Template previews (sample data)</h2>
    <div class="ad-top__tools" style="margin-bottom:var(--s3)">
      <select data-tpl aria-label="Template">{TEMPLATE_NAMES.map((n) => <option value={n}>{n}</option>)}</select>
      <div class="ad-widths"><span>Width:</span><button type="button" data-width="600" aria-pressed="true">Gmail 600</button><button type="button" data-width="640">Outlook 640</button><button type="button" data-width="700">Apple Mail 700</button><button type="button" data-width="375">Phone 375</button></div>
    </div>
    <div class="ad-preview"><iframe data-frame title="Email preview" style="width:600px" src="about:blank"></iframe></div>
    <p class="ad-small" style="margin-top:var(--s3)">Test sends go to john@telning.com only: <code>npm run emails:test-send -- &lt;template&gt;</code> (needs RESEND_API_KEY).</p>
  </section>
  <section class="ad-card"><h2>Send log</h2><div data-log><div class="ad-empty">Loading…</div></div></section>
</Admin>

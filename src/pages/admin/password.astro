---
import Admin from '../../layouts/Admin.astro';
---
<Admin title="Change password" page="/admin/password">
  <form class="ad-form" data-pw-form>
    <label class="ad-field"><span>New password (16 characters or more)</span><input class="tn-input" type="password" name="pw1" autocomplete="new-password" minlength="16" required /></label>
    <label class="ad-field"><span>Repeat it</span><input class="tn-input" type="password" name="pw2" autocomplete="new-password" minlength="16" required /></label>
    <div class="ad-actions"><button class="tn-btn" type="submit">Change password</button></div>
    <p class="ad-small">Forgot it? Use “Reset password” in the Supabase dashboard, or the branded reset email (server/emails/compiled/auth-reset.html pasted into Supabase → Authentication → Email templates).</p>
  </form>
</Admin>

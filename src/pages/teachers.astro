---
/* /teachers — For teachers: why wordless works in class, TADA for the classroom, topics (SEL allowed here),
   the teacher pack sign-up (EmailBlock tag teacher), next. Scroll story: children's drawings clip onto a string.
   Copy: src/data/pages/teachers.json (draft). */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Obj from '../components/Obj.astro';
import KidDrawing from '../components/KidDrawing.astro';
import EmailBlock from '../components/EmailBlock.astro';
import t from '../data/pages/teachers.json';

const PAGE = '/teachers';
const PEGS = [0.12, 0.3, 0.48, 0.66, 0.84];
---
<Base page={PAGE}>
  <Header />
  <main id="main" tabindex="-1">
    <PageHero page={PAGE} h1={t.h1} lead={t.lead} colour="gold-light">
      <Fragment slot="after"><p class="tn-p">{t.intro}</p></Fragment>
      <div class="tn-layer" style="--d:6;top:10%;left:6%;right:6%;height:2px;background:var(--ink-soft)"></div>
      {[0, 1, 2].map((i) => (<div class="tn-layer" style={`--d:${10 + i * 4};top:9%;left:${12 + i * 30}%;width:20%`}><div class="tn-string__sheet" style={`--r:${[-6, 4, -3][i]}deg`}><span class="tn-string__peg"></span><KidDrawing /></div></div>))}
      <div class="tn-layer" style="--d:14;bottom:0;left:0;width:100%;height:34%;background:var(--gold-deep);opacity:.9"></div>
      <div class="tn-layer" style="--d:18;bottom:34%;left:0;width:100%;height:6px;background:var(--gold-deep)"></div>
      <div class="tn-layer" style="--d:24;bottom:40%;left:8%;width:22%"><Obj name="bookstack" w="100%" /></div>
      <div class="tn-layer" style="--d:26;bottom:40%;left:34%;width:12%"><Obj name="blocks" w="100%" /></div>
      <div class="tn-layer tn-hide-sm" style="--d:28;bottom:40%;right:10%;width:10%"><Obj name="apple" w="100%" /></div>
      <div class="tn-layer tn-hide-sm" style="--d:30;bottom:41%;right:24%;width:9%;--r:-14deg"><div class="tn-tilted"><Obj name="crayon-sea" w="100%" /></div></div>
    </PageHero>

    <section class="tn-section" id="why" aria-labelledby="why-h" style="padding-top:0"><div class="tn-wrap">
      <div class="tn-head tn-reveal"><h2 class="tn-h2" id="why-h" tabindex="-1">{t.why.h2}</h2><p class="tn-lead">{t.why.therapists}</p></div>
      <ul class="tn-cards tn-cards--4">
        {t.why.cards.map((c) => (<li class="tn-card tn-reveal"><span class="tn-card__ic" style={`--c:var(--${c.c})`} aria-hidden="true"><Obj name={c.icon} w="100%" flat /></span><h3 class="tn-h3">{c.h}</h3><p class="tn-p">{c.t}</p></li>))}
      </ul>
    </div></section>

    <section class="tn-section" id="how" aria-labelledby="how-h" style="padding-top:0"><div class="tn-wrap">
      <div class="tn-head tn-reveal"><h2 class="tn-h2" id="how-h" tabindex="-1">{t.how.h2}</h2><p class="tn-lead">{t.how.lead}</p></div>
      <div class="tn-stringstory tn-view">
        <div class="tn-string" aria-hidden="true">
          <span class="tn-string__line"></span>
          {PEGS.map((at, i) => (<div class="tn-string__sheet tn-string__sheet--story" style={`--at:${at};--x:${6 + i * 19}%;--r:${[-5, 4, -2, 5, -4][i]}deg`}><span class="tn-string__peg"></span><KidDrawing /></div>))}
        </div>
        <ol class="tn-cards tn-cards--3 tn-steps3">
          {t.how.modes.map((m) => (<li class="tn-card tn-reveal"><h3 class="tn-h3">{m.h}</h3><p class="tn-small"><strong>{m.time}</strong></p><p class="tn-p">{m.t}</p></li>))}
        </ol>
        <p class="tn-p tn-reveal" style="margin-top:var(--s5)"><a class="tn-link tn-link--solo" href="/tada">{t.how.link}</a></p>
      </div>
    </div></section>

    <section class="tn-section" id="topics" aria-labelledby="topics-h" style="padding-top:0"><div class="tn-wrap">
      <div class="tn-head tn-reveal"><h2 class="tn-h2" id="topics-h" tabindex="-1">{t.topics.h2}</h2><p class="tn-lead">{t.topics.lead}</p></div>
      <ul class="tn-cards tn-cards--4">
        {t.topics.items.map((c) => (<li class="tn-card tn-card--tinted tn-reveal" style="--c:var(--sky-light)"><h3 class="tn-h3">{c.h}</h3><p class="tn-p">{c.t}</p></li>))}
      </ul>
    </div></section>

    <EmailBlock id="teacher-pack" tag="teacher" h2={t.pack.h2} line={t.pack.line} button={t.pack.button} consent={t.pack.consent} thanks={t.pack.thanks} class="tn-section--tight" />

    <section class="tn-section" id="next" aria-labelledby="next-h" style="padding-top:0"><div class="tn-wrap">
      <div class="tn-next tn-reveal"><h2 class="tn-h2" id="next-h" tabindex="-1">{t.next.h2}</h2><p class="tn-lead">{t.next.text}</p>
        <div class="tn-actions"><a class="tn-btn" href="/tada">{t.next.button}</a><a class="tn-link tn-link--solo" href="/guide">{t.next.link}</a></div></div>
    </div></section>
  </main>
  <Footer />
</Base>

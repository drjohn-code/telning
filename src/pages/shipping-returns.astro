---
/* /shipping-returns — delivery times and fees per region (from src/data/shop.json), parcels, returns (EU law in every
   market), damaged items. No partner names, no factory countries. DRAFT: a lawyer checks the returns text. */
import LegalPage from '../components/LegalPage.astro';
import { shop, site, money } from '../lib/shop';

const fee = (k: string, c: string) => money(Math.round((shop.parcels as any)[k].first[c] * 100), c, (shop.currencies as any)[c].locale);
const extra = (c: string) => money(Math.round((shop.parcels as any).books.extra[c] * 100), c, (shop.currencies as any)[c].locale);
const R: Record<string, string> = { EU: 'EUR', UK: 'GBP', US: 'USD', CA: 'CAD' };
const regions = Object.entries(shop.regions as any).map(([k, r]: [string, any]) => `<strong>${r.name}</strong>: ${r.delivery[0]}–${r.delivery[1]} working days. Books ${fee('books', R[k])}, Story Walls ${fee('posters', R[k])}, mugs ${fee('mugs', R[k])}, tote bags ${fee('totes', R[k])}, postcards and greeting cards ${fee('cards', R[k])} per parcel; ${extra(R[k])} for each extra item in the same parcel.`);
const sections = [
  { id: 'where', h: 'Where we deliver', p: ['We deliver to the European Union, the United Kingdom, the United States and Canada. The currency you choose in the basket sets the delivery region: euros for the EU, pounds for the UK, US dollars for the US and Canadian dollars for Canada.'] },
  { id: 'made', h: 'Made for you after you order', p: ['Nothing waits in a warehouse. When you order, each item is made for you by our trusted printing and delivery partners, as close to your address as we can.', 'Books, Story Walls and gifts are each made in their own workshop, so items may arrive in separate parcels, sometimes on different days. Each parcel has its own tracking link.'] },
  { id: 'times', h: 'Delivery times and shipping costs', p: ['EU 3–10 working days, US/UK/Canada 3–7 working days, including the time it takes to make your items. Shipping is a flat fee per parcel, shown in the basket before you pay:'], list: regions },
  { id: 'tracking', h: 'Tracking', p: ['You get an order confirmation by email after you pay. When a parcel ships, we email you its tracking link. Story Walls travel rolled in a sturdy tube.'] },
  { id: 'duties', h: 'Customs and duties', p: ['We make your items in your region so that you do not pay import duties. If a parcel ever arrives with a duty or a fee to pay, write to us and we sort it out.'] },
  { id: 'change', h: 'Changing or cancelling an order', p: [`Write to us at once at <a href="mailto:${site.contactEmail}">${site.contactEmail}</a> with your order number if you need to change or cancel something. Once an item is being made, it cannot be changed, but you can still return it (see below).`] },
  { id: 'returns', h: 'Returns within 14 days', p: ['Our returns policy follows EU law in every market, also in the UK, the US and Canada:'], list: ['You can cancel your purchase within 14 days of the day the parcel arrives, without giving a reason.', `Tell us first by email at <a href="mailto:${site.contactEmail}">${site.contactEmail}</a> with your order number.`, 'Send the items back unused, in their packaging where possible, to our address in Sweden (we send it with our reply). You pay the return postage.', 'We refund the price of the items and the standard delivery cost within 14 days of receiving them, to the card you paid with.'] },
  { id: 'damaged', h: 'Damaged, faulty or wrong items', p: [`If something arrives damaged, faulty or not what you ordered, email us at <a href="mailto:${site.contactEmail}">${site.contactEmail}</a> with your order number and a photo. We send a new one or refund it, at our cost. You do not need to send the item back unless we ask.`] },
  { id: 'questions', h: 'Questions', p: [`Write to <a href="mailto:${site.contactEmail}">${site.contactEmail}</a>. Read the <a href="/terms">Terms</a> and <a href="/materials">Our materials</a>.`] },
];
---
<LegalPage page="/shipping-returns" h1="Shipping & returns" lead="Where we deliver, how long it takes, what it costs, and how to send something back. Short sections, plain English." sections={sections} tocLabel="On this page" updatedLabel="Last updated" draftLabel="Draft: needs a legal check" />

---
/* /materials — Our materials: each product's paper, fabric, ink and where it is printed, each claim next to its proof
   (EU Directive 2024/825: no general green words, name the certificate). DRAFT: confirm each certificate with the
   printer (Lulu FSC line, Printful tote and inks, Gelato card paper) before the shop opens. */
import LegalPage from '../components/LegalPage.astro';
import { shop } from '../lib/shop';
const T = shop.types as any;
const L = (href: string, t: string) => `<a href="${href}" rel="noopener">${t}</a>`;
const sections = [
  { id: 'books', h: 'Colouring books', p: [T.book.materials, 'Square, 21.6 × 21.6 cm (8.5 × 8.5 in), 32 pages, black-and-white inside for colouring, drawings on right-hand pages only so pens never show through onto the next drawing.', `Printed by ${L('https://www.lulu.com/', 'Lulu')}. FSC: ${L('https://fsc.org/en', 'Forest Stewardship Council')}.`] },
  { id: 'posters', h: 'Giant colouring posters', p: [T.poster.materials, `Printed by ${L('https://www.printful.com/', 'Printful')} in its own print shops in Europe and North America.`] },
  { id: 'totes', h: 'Tote bags', p: [T.tote.materials, T.tote.care, `Certificates: ${L('https://global-standard.org/', 'GOTS (Global Organic Textile Standard)')}, ${L('https://textileexchange.org/organic-content-standard/', 'OCS (Organic Content Standard)')}, ${L('https://www.oeko-tex.com/en/', 'OEKO-TEX')}.`] },
  { id: 'mugs', h: 'Mugs', p: [T.mug.materials, 'Ceramic that meets the EU limits for lead and cadmium in food-contact ceramics.', T.mug.care, 'Mugs are not organic and we do not say they are.'] },
  { id: 'cards', h: 'Postcards and greeting cards', p: [T.postcards.materials, T.cards.materials, `Printed by ${L('https://www.gelato.com/', 'Gelato')} in its network of local print shops.`] },
  { id: 'words', h: 'The words we use', p: ['We do not call our products “eco-friendly”, “green” or “sustainable”. Since 27 September 2026, EU rules allow only specific claims with clear proof. So we name the certificate instead, next to the claim, on the same page: FSC paper, GOTS organic cotton, OEKO-TEX fabric.', 'Designed in Sweden by Telning Publishing House. Printed close to you, not in Sweden.'] },
  { id: 'packaging', h: 'Packaging', p: ['Each printer packs its own parcel. We list the packaging of each product here once we have checked it with the printer.'] },
];
---
<LegalPage page="/materials" h1="Our materials" lead="What every Telning book, poster and gift is made of, where it is printed, and the certificate behind each claim." sections={sections} tocLabel="On this page" updatedLabel="Last updated" draftLabel="Draft: certificates to confirm" />

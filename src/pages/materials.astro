---
/* /materials — Our materials: each product's paper, fabric and ink, each claim next to its certificate
   (EU Directive 2024/825: no general environmental words, name the certificate). No partner names here.
   DRAFT: confirm each certificate with the partners before the shop opens. */
import LegalPage from '../components/LegalPage.astro';
import { shop } from '../lib/shop';
const T = shop.types as any;
const L = (href: string, t: string) => `<a href="${href}" rel="noopener">${t}</a>`;
const sections = [
  { id: 'promise', h: 'Premium quality, made for you', p: ['Nothing waits in a warehouse. Every book, Story Wall and gift is made after you order it, by our trusted printing and delivery partners, as close to you as we can. That is why it takes a few working days, and why nothing is printed that nobody wants.', 'Each material below carries the certificate behind the claim. We name the certificate, not a slogan.'] },
  { id: 'books', h: 'Colouring books', p: [T.book.materials, 'Square, 21.6 × 21.6 cm (8.5 × 8.5 in), 32 pages, black-and-white inside for colouring, drawings on right-hand pages only so pens never show through onto the next drawing.', `Certificate: ${L('https://fsc.org/en', 'FSC, the Forest Stewardship Council')}.`] },
  { id: 'posters', h: 'Story Walls', p: [T.poster.materials, 'Large colouring picture for the wall, 100 × 70 cm landscape. About 15% of the picture comes painted as a colour guide; the rest is clean black line art. For ages 3–5 every shape is 20% bigger.'] },
  { id: 'totes', h: 'Tote bags', p: [T.tote.materials, T.tote.care, `Certificates: ${L('https://global-standard.org/', 'GOTS (Global Organic Textile Standard)')}, ${L('https://textileexchange.org/organic-content-standard/', 'OCS (Organic Content Standard)')}, ${L('https://www.oeko-tex.com/en/', 'OEKO-TEX')}.`] },
  { id: 'mugs', h: 'Mugs', p: [T.mug.materials, 'Ceramic that meets the EU limits for lead and cadmium in food-contact ceramics.', T.mug.care, 'Mugs are not organic and we do not say they are.'] },
  { id: 'cards', h: 'Postcards and greeting cards', p: [T.postcards.materials, T.cards.materials, `Certificate: ${L('https://fsc.org/en', 'FSC')}.`] },
  { id: 'words', h: 'The words we use', p: ['Since 27 September 2026, EU rules allow only specific environmental claims with clear proof. So we do not use general words about the planet. We name the certificate instead, next to the claim, on the same page: FSC paper, GOTS organic cotton, OEKO-TEX fabric.', 'Designed in Sweden by Telning Publishing House. Made for you after you order.'] },
  { id: 'packaging', h: 'Packaging', p: ['Books travel in a cardboard mailer, Story Walls rolled in a sturdy tube, mugs in a padded box, tote bags and cards in a paper envelope. We list the exact packaging of each item here once we have checked a sample of every product.'] },
];
---
<LegalPage page="/materials" h1="Our materials" lead="What every Telning book, Story Wall and gift is made of, and the certificate behind each claim. Premium quality, made for you." sections={sections} tocLabel="On this page" updatedLabel="Last updated" draftLabel="Draft: certificates to confirm" />

---
/* /gifts — Gifts: four tiles (Mugs, Tote bags, Postcards, Greeting cards), then every design, filtered by product
   and occasion. Gifts carry their own designs, not tied to a series. Words: keepsake, never reward or prize. */
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PimNote from '../../components/PimNote.astro';
import ProductCard from '../../components/shop/ProductCard.astro';
import TrustBar from '../../components/shop/TrustBar.astro';
import CurrencySelect from '../../components/shop/CurrencySelect.astro';
import Picture from '../../components/shop/Picture.astro';
import { catalog, shop, gifts, view, giftPath, GIFT_TYPES, money } from '../../lib/shop';

const PAGE = '/gifts';
const LINES: Record<string, string> = {
  mug: 'For the grown-up who reads the story every night.',
  tote: 'The book, the crayons, the library trip.',
  postcards: 'Ten cards to write and send to Grandma.',
  cards: 'Ten cards, blank inside for your own words.',
};
const COVER: Record<string, string> = { mug: view('mug-cocoa-cat', 'table'), tote: view('tote-cat-parade', 'table'), postcards: view('postcards-pumpkin-patch-cats', 'table'), cards: view('cards-boo-cat', 'table') };
const products = GIFT_TYPES.flatMap((t: string) => catalog.products.filter((p: any) => p.type === t));
const from = (t: string) => { const p: any = products.find((x: any) => x.type === t); const pr = p.variants ? p.variants[0].price : p.price; return Object.fromEntries(['EUR', 'GBP', 'USD', 'CAD'].map((c) => [`data-${c.toLowerCase()}`, money(pr[c], c, (shop.currencies as any)[c].locale)])); };
const occasions = [...new Set(products.map((p: any) => p.occasion).filter(Boolean))] as string[];
const animals = products.some((p: any) => p.animal);   // the cats and dogs (Halloween, Christmas, New Year, birthday)
const plants = products.some((p: any) => p.animal === 'plants');   // the plant mugs (John, 16 Oct 2026)
const children = products.some((p: any) => p.child);   // the birthday cards, for girls or for boys (John, 15 Oct 2026)
import FilterSheet from '../../components/shop/FilterSheet.astro';
---
<Base page={PAGE} preload={{ src: '/shop/img/gift-set/gift-set-halloween-gift-set', sizes: '(min-width: 1024px) 520px, 100vw' }}>
  <Header />
  <main id="main" tabindex="-1">
    <section class="tn-wrap tn-shophero" aria-labelledby="page-h">
      <Breadcrumbs page={PAGE} />
      <div class="tn-shophero__in">
        <div class="tn-shophero__text">
          <h1 class="tn-h1" id="page-h" tabindex="-1">Gifts</h1>
          <p class="tn-lead">Mugs, tote bags, postcards and greeting cards with our cats and dogs: every day and Halloween on the mugs and bags; birthdays, Halloween, Christmas and New Year on the cards. Keepsakes that keep the story going, after the last page.</p>
          <PimNote line="The grown-ups get something too." size="sm" />
        </div>
        <div class="tn-shophero__art" aria-hidden="true">
          <Picture class="tn-shophero__a" src="/shop/img/gift-set/gift-set-halloween-gift-set" alt="" eager sizes="(min-width: 1024px) 520px, 100vw" />
        </div>
      </div>
    </section>

    <section class="tn-wrap" aria-labelledby="tiles-h">
      <h2 class="tn-sr" id="tiles-h">The four gifts</h2>
      <ul class="tn-gifttiles">{GIFT_TYPES.map((t: string) => { const ty = (shop.types as any)[t]; const a = from(t); return (
        <li><a class="tn-gifttile" href={giftPath(t)}>
          <Picture src={COVER[t]} alt="" widths={[600]} sizes="(min-width: 1024px) 280px, 50vw" eager />
          <span class="tn-gifttile__body"><span class="tn-gifttile__name">{ty.tile}</span><span class="tn-gifttile__line">{LINES[t]}</span><span class="tn-gifttile__from">From <span class="tn-price" {...a}>{a['data-eur']}</span></span></span>
        </a></li>); })}</ul>
    </section>

    <section class="tn-wrap tn-shopgrid" aria-labelledby="all-h">
      <h2 class="tn-h2 tn-h2--s" id="all-h">Every design</h2>
      <FilterSheet id="f-gifts" count={products.length}>
        <div class="tn-filters__g" role="group" aria-label="Product"><span class="tn-filters__l">Product</span>
          <button type="button" class="tn-chip" data-group="type" data-value="">All</button>
          {GIFT_TYPES.map((t: string) => <button type="button" class="tn-chip" data-group="type" data-value={t}>{(shop.types as any)[t].tile}</button>)}
        </div>
        {occasions.length > 1 && (        <div class="tn-filters__g tn-filters__g--scroll" role="group" aria-label="Occasion"><span class="tn-filters__l">Occasion</span>
          <button type="button" class="tn-chip" data-group="occasion" data-value="">All</button>
          {occasions.map((o) => <button type="button" class="tn-chip" data-group="occasion" data-value={o}>{(gifts.occasions as any)[o]}</button>)}
        </div>)}
        {animals && (<div class="tn-filters__g" role="group" aria-label="Characters"><span class="tn-filters__l">Characters</span>
          <button type="button" class="tn-chip" data-group="animal" data-value="">All</button>
          <button type="button" class="tn-chip" data-group="animal" data-value="cat">Cats</button>
          <button type="button" class="tn-chip" data-group="animal" data-value="dog">Dogs</button>
          {plants && <button type="button" class="tn-chip" data-group="animal" data-value="plant">Plants</button>}
        </div>)}
        {children && (<div class="tn-filters__g" role="group" aria-label="For"><span class="tn-filters__l">For</span>
          <button type="button" class="tn-chip" data-group="child" data-value="">All</button>
          <button type="button" class="tn-chip" data-group="child" data-value="girl">Girls</button>
          <button type="button" class="tn-chip" data-group="child" data-value="boy">Boys</button>
        </div>)}
        </FilterSheet>
      <ul class="tn-pgrid" id="grid">{products.map((p: any) => <ProductCard p={p} />)}</ul>
    </section>

    <section class="tn-section tn-section--tight" aria-labelledby="keep-h"><div class="tn-wrap tn-split">
      <div class="tn-split__img"><Picture src={view('book-star-hoppers-3-5', 'last-page')} alt="The last page of a Telning colouring book, open on a table, where the child draws the ending" sizes="(min-width: 1024px) 560px, 100vw" /></div>
      <div class="tn-split__text">
        <h2 class="tn-h2" id="keep-h">A keepsake, after the last page</h2>
        <p class="tn-lead">Your child chose the ending and drew it. A mug at breakfast or a card on the fridge keeps that story in daily life, so it gets told again.</p>
        <p class="tn-p">One rule from the research on children’s drawing: give it after the drawing, as a surprise, never as a promise before. Children who expect something for drawing draw less on their own; a surprise does not have that effect.</p>
        <p class="tn-p"><a class="tn-link tn-link--solo" href="/tada">Read the TADA way</a></p>
      </div>
    </div></section>

    <section class="tn-section tn-section--tight" aria-label="Our promises"><div class="tn-wrap"><TrustBar /></div></section>
  </main>
  <Footer />
</Base>

---
/* /gifts/mugs, /gifts/tote-bags, /gifts/postcards, /gifts/greeting-cards: every design of one gift. */
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductCard from '../../../components/shop/ProductCard.astro';
import TrustBar from '../../../components/shop/TrustBar.astro';
import CurrencySelect from '../../../components/shop/CurrencySelect.astro';
import Picture from '../../../components/shop/Picture.astro';
import { catalog, shop, gifts, view, giftPath, GIFT_TYPES, money } from '../../../lib/shop';

export function getStaticPaths() {
  return GIFT_TYPES.map((t: string) => ({ params: { type: giftPath(t).split('/')[2] }, props: { t } }));
}
const { t } = Astro.props as any;
const PAGE = giftPath(t);
const ty = (shop.types as any)[t];
const products = catalog.products.filter((p: any) => p.type === t);
const occasions = [...new Set(products.map((p: any) => p.occasion).filter(Boolean))] as string[];
const p0: any = products[0];
const pr = p0.variants ? p0.variants[0].price : p0.price;
const fromAttrs = Object.fromEntries(['EUR', 'GBP', 'USD', 'CAD'].map((c) => [`data-${c.toLowerCase()}`, money(pr[c], c, (shop.currencies as any)[c].locale)]));
/* Halloween only for now (John, 13 Oct 2026): placeholder pictures until the mockups exist */
const HERO: Record<string, string> = { mug: view('mug-cocoa-cat', 'table'), tote: view('tote-cat-parade', 'table'), postcards: view('postcards-pumpkin-patch-cats', 'table'), cards: view('cards-boo-cat', 'table') };
const animals = products.some((p: any) => p.animal);
const others = GIFT_TYPES.filter((x: string) => x !== t);
const COVER: Record<string, string> = HERO;
import FilterSheet from '../../../components/shop/FilterSheet.astro';
---
<Base page={PAGE} preload={{ src: HERO[t], sizes: '(min-width: 1024px) 520px, 100vw' }}>
  <Header />
  <main id="main" tabindex="-1">
    <section class="tn-wrap tn-shophero" aria-labelledby="page-h">
      <Breadcrumbs page={PAGE} />
      <div class="tn-shophero__in">
        <div class="tn-shophero__text">
          <h1 class="tn-h1" id="page-h" tabindex="-1">{ty.plural}</h1>
          <p class="tn-lead">{ty.scene}</p>
          <p class="tn-shophero__line">{ty.facts.slice(0, 3).join(' · ')}</p>
          {ty.regions && <p class="tn-shophero__line">Delivered to Europe and the UK only. Not available in the US and Canada.</p>}
          <p class="tn-shophero__from">From <span class="tn-price" {...fromAttrs}>{fromAttrs['data-eur']}</span> · {products.length} designs</p>
        </div>
        <div class="tn-shophero__art" aria-hidden="true">
          <Picture class="tn-shophero__a" src={HERO[t]} alt="" eager sizes="(min-width: 1024px) 520px, 100vw" />
        </div>
      </div>
    </section>

    <section class="tn-wrap tn-shopgrid" aria-labelledby="all-h">
      <h2 class="tn-h2 tn-h2--s" id="all-h">The designs</h2>
      {(occasions.length > 1 || animals) && (
        <FilterSheet id="f-type" count={products.length}>
          {occasions.length > 1 && (<div class="tn-filters__g tn-filters__g--scroll" role="group" aria-label="Occasion"><span class="tn-filters__l">Occasion</span>
            <button type="button" class="tn-chip" data-group="occasion" data-value="">All</button>
            {occasions.map((o) => <button type="button" class="tn-chip" data-group="occasion" data-value={o}>{(gifts.occasions as any)[o]}</button>)}
          </div>)}
          {animals && (<div class="tn-filters__g" role="group" aria-label="Characters"><span class="tn-filters__l">Characters</span>
            <button type="button" class="tn-chip" data-group="animal" data-value="">All</button>
            <button type="button" class="tn-chip" data-group="animal" data-value="cat">Cats</button>
            <button type="button" class="tn-chip" data-group="animal" data-value="dog">Dogs</button>
          </div>)}
        </FilterSheet>
      )}
      <ul class="tn-pgrid" id="grid">{products.map((p: any, i: number) => <ProductCard p={p} eager={i < 4} />)}</ul>
    </section>

    <section class="tn-section tn-section--tight" aria-labelledby="mat-h"><div class="tn-wrap">
      <div class="tn-next">
        <h2 class="tn-h2 tn-h2--s" id="mat-h">Material and care</h2>
        <p class="tn-p">{ty.materials}</p>
        <p class="tn-p">{ty.care}</p>
        <p><a class="tn-link tn-link--solo" href="/materials">Our materials and certificates</a></p>
      </div>
    </div></section>

    <section class="tn-section tn-section--tight" aria-labelledby="other-h"><div class="tn-wrap">
      <div class="tn-head"><h2 class="tn-h2 tn-h2--s" id="other-h">More gifts</h2></div>
      <ul class="tn-gifttiles tn-gifttiles--3">{others.map((x: string) => (
        <li><a class="tn-gifttile" href={giftPath(x)}><Picture src={COVER[x]} alt="" widths={[600]} sizes="(min-width: 1024px) 280px, 50vw" /><span class="tn-gifttile__body"><span class="tn-gifttile__name">{(shop.types as any)[x].tile}</span></span></a></li>))}</ul>
      <p class="tn-p" style="margin-top:var(--s5)"><a class="tn-link tn-link--solo" href="/gifts">All gifts</a></p>
    </div></section>

    <section class="tn-section tn-section--tight" aria-label="Our promises"><div class="tn-wrap"><TrustBar /></div></section>
  </main>
  <Footer />
</Base>

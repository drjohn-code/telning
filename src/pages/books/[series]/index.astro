---
/* /books/<series>: one series — its world, its two colouring books and two Story Walls, the stories, and sets. */
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductCard from '../../../components/shop/ProductCard.astro';
import Price from '../../../components/shop/Price.astro';
import TrustBar from '../../../components/shop/TrustBar.astro';
import Picture from '../../../components/shop/Picture.astro';
import { catalog, site, books, shop, view, ageLabel, money } from '../../../lib/shop';

export function getStaticPaths() {
  return site.series.filter((s: any) => (books.series as any)[s.key]).map((s: any) => ({ params: { series: s.key }, props: { s } }));
}
const { s } = Astro.props as any;
const PAGE = `/books/${s.key}`;
const b = (books.series as any)[s.key];
const get = (k: string) => catalog.bySku.get(k) as any;
const items = ['3-5', '5-7'].flatMap((a) => [get(`book-${s.key}-${a}`), get(`poster-${s.key}-${a}`)]);
const sets = ['3-5', '5-7'].map((a) => ({ age: a, title: b.books[a].title, name: a === '3-5' ? 'Book + Story Wall' : 'After the last page', items: a === '3-5' ? [get(`book-${s.key}-${a}`), get(`poster-${s.key}-${a}`)] : [get(`book-${s.key}-${a}`), get(`poster-${s.key}-${a}`), get('postcards-under-the-same-sky')] }));
const totalAttrs = (list: any[]) => Object.fromEntries(['EUR', 'GBP', 'USD', 'CAD'].map((c) => [`data-${c.toLowerCase()}`, money(list.reduce((a, x) => a + (x.variants ? x.variants[0].price : x.price)[c], 0), c, (shop.currencies as any)[c].locale)]));
const others = site.series.filter((x: any) => x.key !== s.key);
const ld = [{ '@type': 'CollectionPage', '@id': `https://telning.com${PAGE}#collection`, name: s.name, url: `https://telning.com${PAGE}`, about: s.theme, mainEntity: { '@type': 'ItemList', itemListElement: items.map((p: any, i: number) => ({ '@type': 'ListItem', position: i + 1, url: `https://telning.com${p.url}`, name: p.name })) } }];
---
<Base page={PAGE} jsonld={ld} preload={{ src: view(`poster-${s.key}-5-7`, 'wall'), sizes: '(min-width: 1024px) 520px, 100vw' }}>
  <Header />
  <main id="main" tabindex="-1">
    <section class="tn-wrap tn-shophero tn-shophero--series" aria-labelledby="page-h" style={`--c:var(--${s.colour})`}>
      <Breadcrumbs page={PAGE} />
      <div class="tn-shophero__in">
        <div class="tn-shophero__text">
          <p class="tn-pdp__kick">Series · {s.theme}</p>
          <h1 class="tn-h1" id="page-h" tabindex="-1">{s.name}</h1>
          <p class="tn-lead">{b.world}</p>
          <p class="tn-shophero__line">2 colouring books · 2 Story Walls · Ages 3–5 and 5–7</p>
        </div>
        <div class="tn-shophero__art tn-shophero__art--covers" aria-hidden="true">
          <Picture class="tn-shophero__a" src={view(`poster-${s.key}-5-7`, 'wall')} alt="" eager sizes="(min-width: 1024px) 520px, 100vw" />
          <Picture class="tn-shophero__b" src={view(`book-${s.key}-3-5`, 'cover')} alt="" widths={[600]} sizes="200px" />
        </div>
      </div>
    </section>

    <section class="tn-wrap tn-shopgrid" aria-labelledby="items-h">
      <h2 class="tn-h2 tn-h2--s" id="items-h">The books and Story Walls</h2>
      <ul class="tn-pgrid tn-pgrid--4">{items.map((p: any, i: number) => <ProductCard p={p} eager={i < 2} />)}</ul>
    </section>

    <section class="tn-section tn-section--tight" aria-labelledby="stories-h"><div class="tn-wrap">
      <div class="tn-head"><h2 class="tn-h2 tn-h2--s" id="stories-h">The stories</h2></div>
      <ul class="tn-stories">{['3-5', '5-7'].map((a) => { const bk = b.books[a]; const p = get(`book-${s.key}-${a}`); return (
        <li class="tn-story">
          <a class="tn-story__img" href={p.url} tabindex="-1" aria-hidden="true"><Picture src={view(`book-${s.key}-${a}`, 'cover')} alt="" widths={[600]} sizes="160px" /></a>
          <div class="tn-story__text">
            <p class="tn-pill tn-pill--soft">Ages {ageLabel(a)}</p>
            <h3 class="tn-h3"><a href={p.url}>{bk.title}</a></h3>
            <p class="tn-p">{bk.story}</p>
            <p class="tn-p"><strong>The choice:</strong> {bk.choice}</p>
          </div>
        </li>); })}</ul>
    </div></section>

    <section class="tn-section tn-section--tight" aria-labelledby="sets-h"><div class="tn-wrap">
      <div class="tn-head"><h2 class="tn-h2 tn-h2--s" id="sets-h">Sets</h2><p class="tn-lead">Colour the story in the book, then the whole world on the wall.</p></div>
      <ul class="tn-sets">{sets.map((st) => (
        <li class="tn-bundle">
          <p class="tn-pdp__keepk">{st.title}</p>
          <h3 class="tn-h3">{st.name}</h3>
          <ul class="tn-bundle__items">{st.items.map((x: any) => <li><Picture src={x.images[0].src} alt="" widths={[600]} sizes="56px" width={120} height={120} /><span><a href={x.url}>{x.name}</a><Price p={x} /></span></li>)}</ul>
          <p class="tn-bundle__total">Together <span class="tn-price" {...totalAttrs(st.items)}>{totalAttrs(st.items)['data-eur']}</span></p>
          <button class="tn-btn tn-btn--secondary" type="button" data-add={JSON.stringify(st.items.map((x: any) => ({ sku: x.sku, variant: '', qty: 1, max: x.maxQty })))}>Add all {st.items.length} to basket</button>
        </li>))}</ul>
    </div></section>

    <section class="tn-section tn-section--tight" aria-labelledby="other-h"><div class="tn-wrap">
      <div class="tn-head"><h2 class="tn-h2 tn-h2--s" id="other-h">More series</h2></div>
      <ul class="tn-serieslist tn-serieslist--small">{others.map((x: any) => (
        <li><a class="tn-seriestile" href={`/books/${x.key}`} style={`--c:var(--${x.colour})`}>
          <Picture src={view(`book-${x.key}-3-5`, 'cover')} alt="" widths={[600]} sizes="(min-width: 1024px) 180px, 45vw" />
          <span class="tn-seriestile__name">{x.name}</span><span class="tn-seriestile__theme">{x.theme}</span>
        </a></li>))}</ul>
      <p class="tn-p" style="margin-top:var(--s5)"><a class="tn-link tn-link--solo" href="/books">All books &amp; posters</a></p>
    </div></section>

    <section class="tn-section tn-section--tight" aria-label="Our promises"><div class="tn-wrap"><TrustBar /></div></section>
  </main>
  <Footer />
</Base>

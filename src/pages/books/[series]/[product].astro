---
/* /books/<series>/colouring-book-<age> and /books/<series>/giant-poster-<age>: one page per book and poster. */
import ProductPage from '../../../components/shop/ProductPage.astro';
import { catalog } from '../../../lib/shop';
export function getStaticPaths() {
  return catalog.products.filter((p: any) => p.category === 'books').map((p: any) => ({ params: { series: p.series, product: p.url.split('/').pop() }, props: { p } }));
}
const { p } = Astro.props;
---
<ProductPage p={p} />

---
import Obj from './Obj.astro';
import strings from "../data/strings.en.json";
import PimNote from "./PimNote.astro";
---
<section class="tn-section" id="skills" aria-labelledby="skills-h" style="padding-top:0"><div class="tn-wrap">
  <div class="tn-head tn-reveal"><h2 class="tn-h2" id="skills-h" tabindex="-1">Decision intelligence at the heart</h2></div>
  <div class="tn-skillmap"><div class="tn-skillmain tn-tilt tn-reveal" data-tilt="5"><div class="tn-skillmain__obj tn-pop-far" aria-hidden="true"><div class="tn-float slow"><Obj name="signpost" w="100%" /><div class="tn-skillmain__owl"><Obj name="owl" w="100%" /></div></div></div><h3 class="tn-skillmain__h">Decision intelligence</h3><p class="tn-lead">The heart of every Telning book. Your child sees the choices, thinks about what could happen, and picks one.</p></div><div class="tn-skillside"><ul class="tn-skillrows"><li class="tn-skillrow tn-reveal"><div class="tn-skillrow__obj" aria-hidden="true"><Obj name="heart" w="84px" class="tn-float" /></div><div><h3 class="tn-h3">Emotional intelligence</h3><p class="tn-p">Noticing feelings and naming them.</p></div></li><li class="tn-skillrow tn-reveal"><div class="tn-skillrow__obj" aria-hidden="true"><Obj name="seesaw" w="84px" class="tn-float slow" /></div><div><h3 class="tn-h3">Social skills</h3><p class="tn-p">Sharing, taking turns, making friends.</p></div></li><li class="tn-skillrow tn-reveal"><div class="tn-skillrow__obj" aria-hidden="true"><Obj name="steps" w="84px" class="tn-float late" /></div><div><h3 class="tn-h3">Behavioural skills</h3><p class="tn-p">Trying a new way, step by step.</p></div></li></ul><PimNote class="tn-reveal" line={strings["pim.skills"]} /></div></div>
</div></section>

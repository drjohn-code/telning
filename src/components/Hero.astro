---
import strings from "../data/strings.en.json";
import BookCover from "./BookCover.astro";
import PimNote from "./PimNote.astro";
import Obj from "./Obj.astro";
---
<section class="tn-wrap tn-hero" data-depth-area aria-labelledby="hero-h">
  <div class="tn-hero__text">
    <h1 class="tn-h1" id="hero-h">Little stories, growing minds<span class="tn-dot">.</span></h1>
    <p class="tn-lead">Picture books where your child makes the choices. Every story is built around decision intelligence, with feelings and life skills woven in.</p>
    <p class="tn-hero__line">{strings["hero.line"]}</p><div class="tn-actions"><a class="tn-btn" href="#series">{strings["hero.button"]}</a><a class="tn-btn tn-btn--secondary" href="/gifts">{strings["hero.link"]}</a></div>
  </div>
  <div class="tn-hero__art"><div class="tn-stage tn-scene">
  <div class="tn-stage__box" style="container-type:inline-size">
    <div class="tn-layer " style="--d:4;top:7%;right:7%;width:22%" aria-hidden="true"><Obj name="sun" w="100%" class="tn-spin" eager /></div>
    <div class="tn-layer " style="--d:8;top:10%;left:0;width:100%" aria-hidden="true"><div class="tn-drift" style="--drift:58s;width:24%"><Obj name="cloud" w="100%" eager /></div></div>
    <div class="tn-layer " style="--d:12;top:26%;left:0;width:100%" aria-hidden="true"><div class="tn-drift" style="--drift:84s;animation-delay:-40s;width:17%"><Obj name="cloud" w="100%" eager /></div></div>
    <div class="tn-layer " style="--d:10;top:40%;bottom:-15%;left:0;width:100%" aria-hidden="true"><svg class="tn-hill" viewBox="0 0 400 300" preserveAspectRatio="none" aria-hidden="true"><path d="M0 300V52C40 30 80 20 130 28s90 26 140 20 90-34 130-30v230z" fill="var(--moss)"/></svg></div>
    <div class="tn-layer tn-hide-sm" style="--d:14;bottom:51%;left:8%;width:12%" aria-hidden="true"><Obj name="tree" w="100%" eager /></div>
    <div class="tn-layer " style="--d:18;top:57%;bottom:-15%;left:0;width:100%" aria-hidden="true"><svg class="tn-hill" viewBox="0 0 400 300" preserveAspectRatio="none" aria-hidden="true"><path d="M0 300V46C50 26 110 18 170 30s110 22 160 6 60-20 70-18v236z" fill="var(--forest-light)"/></svg></div>
    <div class="tn-layer " style="--d:20;bottom:38%;right:9%;width:9%" aria-hidden="true"><Obj name="signpost" w="100%" eager /></div>
    <div class="tn-layer " style="--d:22;bottom:33%;left:10%;width:12%" aria-hidden="true"><div class="tn-hop-idle"><Obj name="bunny" w="100%" eager /></div></div>
    <div class="tn-layer tn-hide-sm" style="--d:16;top:12%;right:30%;width:11%" aria-hidden="true"><div class="tn-float"><Obj name="bee" w="100%" eager /></div></div>
    <div class="tn-plane-wrap tn-layer" style="--d:30;inset:0" aria-hidden="true"><div class="tn-plane"><Obj name="plane" w="70px" eager /></div></div>
    <div class="tn-layer " style="--d:30;top:76%;bottom:-15%;left:0;width:100%" aria-hidden="true"><svg class="tn-hill" viewBox="0 0 400 300" preserveAspectRatio="none" aria-hidden="true"><path d="M0 300V40C70 22 140 18 210 28s130 14 190-2v234z" fill="var(--forest)"/></svg></div>
    <div class="tn-layer" style="--d:34;left:22%;bottom:9%;" ><div class="tn-books3"><div class="tn-tilt" data-tilt="10"><BookCover series="home-hearts" /></div><div class="tn-tilt" data-tilt="10"><BookCover series="star-hoppers" /></div><div class="tn-tilt" data-tilt="10"><BookCover series="on-the-move" /></div></div></div>
    <div class="tn-layer " style="--d:40;bottom:3%;left:0;width:100%" aria-hidden="true"><div class="tn-drive"><Obj name="car" w="92px" class="tn-wheels" eager /></div></div>
  </div>
  <div class="tn-layer " style="--d:46;top:-7%;left:44%;width:17%" aria-hidden="true"><div class="tn-float slow"><Obj name="balloon" w="100%" class="tn-sway" eager /></div></div>
  <div class="tn-layer " style="--d:54;bottom:-7%;left:-6%;width:23%" aria-hidden="true"><div class="tn-float late"><Obj name="blocks" w="100%" eager /></div></div>
  <div class="tn-layer " style="--d:60;bottom:-6%;right:-4%;width:20%" aria-hidden="true"><div class="tn-peek"><Obj name="fox" w="100%" eager /></div></div>
</div>
<PimNote class="tn-hero__pim" line={strings["pim.hello"]} />
</div>
</section>

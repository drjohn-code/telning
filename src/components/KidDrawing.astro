---
/* KidDrawing: a child-like crayon drawing (a sun, a house, a tree, flowers, a cloud, a heart) for the sample
   story card and the "send your ending" card. Crayon colours from the tokens, wobbly round-capped strokes,
   scribbled fills. Never Pim, never a series character. Decorative (aria-hidden) unless `label` is given. */
interface Props { class?: string; label?: string }
const { class: cls = '', label } = Astro.props;
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---
<svg class={`tn-kiddraw ${cls}`} viewBox="0 0 300 375" {...a11y} focusable="false" fill="none" stroke-linecap="round" stroke-linejoin="round">
  <!-- sun -->
  <g stroke="var(--gold)" stroke-width="4.5">
    <path d="M232 62c14-12 36-8 42 10s-6 36-24 38-34-10-34-26 8-18 16-22z"/>
    <path d="M226 76l8 10-6 10 10-4 2 12 6-10 10 6-2-12 12-2-10-6 6-10-12 4-2-12-6 10z" stroke="var(--gold-light)" stroke-width="5" opacity=".8"/>
    <path d="M250 28l2 14M286 44l-10 9M296 82h-14M284 118l-9-10M214 44l10 9M206 84h14M218 118l9-10" stroke-width="5"/>
  </g>
  <!-- cloud -->
  <path d="M42 86c-2-14 14-20 24-12 6-12 26-10 28 4 12-2 18 10 10 18-6 6-18 4-24 2-8 6-22 6-30 0-10 2-12-8-8-12z" stroke="var(--sky)" stroke-width="4.5"/>
  <!-- house -->
  <g stroke-width="5">
    <path d="M84 206l-2-64 72-2 2 66" stroke="var(--sea)"/>
    <path d="M70 146l48-44 50 42" stroke="var(--red)"/>
    <path d="M78 150l40-34 42 32-8-2-34-26-32 28z" stroke="var(--red-light)" stroke-width="5" opacity=".75"/>
    <path d="M86 150c20-4 40-4 62-2M88 162c18-2 36-2 56-1M90 174c18-3 36-3 54-2M90 186c16-2 34-2 52-1M92 198c16-2 32-2 48 0" stroke="var(--sky)" stroke-width="5" opacity=".75"/>
    <path d="M106 206v-30c0-4 4-6 8-6h2c4 0 8 2 8 6v30" stroke="var(--forest)"/>
    <path d="M128 156h20v18h-20zM138 156v18M128 165h20" stroke="var(--gold-deep)" stroke-width="4"/>
    <path d="M136 108l2-20 10 2v8" stroke="var(--red-deep)"/>
  </g>
  <!-- tree -->
  <g stroke-width="5">
    <path d="M226 218c-2-20-2-40 0-56" stroke="var(--gold-deep)"/>
    <path d="M226 170c-24-4-36-24-22-40 8-12 26-14 34-2 14-6 30 6 26 22-2 12-14 22-38 20z" stroke="var(--forest)"/>
    <path d="M206 150c10-8 28-8 40-2M202 140c12-10 30-12 44-6M210 130c10-8 22-8 32-2M214 160c10-4 20-4 30-2" stroke="var(--moss)" stroke-width="6" opacity=".8"/>
  </g>
  <!-- grass -->
  <path d="M24 222c40 4 80 4 120 0s90-6 134 0" stroke="var(--moss)" stroke-width="5"/>
  <path d="M36 236l4-12 4 12M56 234l4-10 4 10M250 236l4-12 4 12M270 234l4-10 4 10" stroke="var(--moss)" stroke-width="4"/>
  <!-- flowers -->
  <g stroke-width="4.5">
    <path d="M44 302c0-14 0-28 2-40" stroke="var(--forest-light)"/>
    <path d="M46 250c-8-6-6-18 4-16 4-10 16-8 16 2 10 0 12 12 4 16 4 10-8 16-14 8-8 8-18 0-10-10z" stroke="var(--rose)"/>
    <circle cx="52" cy="248" r="4" stroke="var(--gold)"/>
    <path d="M86 304c0-10 0-20 1-30" stroke="var(--forest-light)"/>
    <path d="M84 264c-6-4-4-14 4-12 2-8 14-6 12 2 8 0 10 10 2 12 2 8-8 12-12 6-8 6-14-2-6-8z" stroke="var(--gold)"/>
    <circle cx="90" cy="263" r="3.5" stroke="var(--red)"/>
  </g>
  <!-- heart and scribble -->
  <path d="M232 296c-6-10 2-22 12-16 10-6 20 4 14 14-4 8-14 14-16 18-4-6-8-10-10-16z" stroke="var(--red)" stroke-width="4.5"/>
  <path d="M236 290c6 2 10 6 12 14M242 286c4 2 8 6 10 12" stroke="var(--red-light)" stroke-width="4" opacity=".8"/>
  <path d="M120 300c10-6 20 4 30-2s18 6 28 0" stroke="var(--sea)" stroke-width="4" opacity=".7"/>
</svg>

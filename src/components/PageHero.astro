---
/* PageHero: every inner page opens with breadcrumbs, the H1 (the LCP element, never animated),
   a lead, an optional first paragraph, and its own paper-theatre scene in the slot (a colour field with
   .tn-layer children; depth follows the pointer through Telning.initDepth). */
import Breadcrumbs from './Breadcrumbs.astro';
interface Props { page: string; h1: string; lead: string; colour?: string; class?: string }
const { page, h1, lead, colour = 'sky-light', class: cls = '' } = Astro.props;
---
<section class={`tn-wrap tn-pagehero ${cls}`} data-depth-area aria-labelledby="page-h">
  <div class="tn-pagehero__text">
    <Breadcrumbs page={page} />
    <h1 class="tn-h1" id="page-h" tabindex="-1">{h1.split('\n').map((line, i) => <span class={i ? 'tn-h1__line tn-h1__line--sub' : 'tn-h1__line'}>{line}{i < h1.split('\n').length - 1 ? ' ' : ''}</span>)}</h1>
    <p class="tn-lead">{lead}</p>
    <slot name="after" />
  </div>
  <div class="tn-pagehero__scene tn-scene" style={`--c:var(--${colour})`} aria-hidden="true">
    <slot />
  </div>
</section>

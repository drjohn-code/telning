---
import Obj from './Obj.astro';
import strings from "../data/strings.en.json";
---
<div class="tn-section tn-section--tight"><div class="tn-wrap"><section class="tn-trust tn-reveal" aria-labelledby="trust-h"><div class="tn-trust__art tn-scene" data-depth-area aria-hidden="true"><div class="tn-layer " style="--d:6;top:9%;left:7%;width:15%;--r:-6deg" aria-hidden="true"><div class="tn-tilted"><Obj name="clipboard" w="100%" /></div></div><div class="tn-layer " style="--d:10;top:0;left:38%;width:13%" aria-hidden="true"><div class="tn-swing"><span class="tn-trust__cord"></span><Obj name="bulb" w="100%" class="tn-glow" /></div></div><div class="tn-trust__stage"><span class="tn-trust__desk"></span><div class="tn-layer " style="--d:16;bottom:16%;left:6%;width:40%" aria-hidden="true"><svg style="--w:100%;" viewBox="0 0 150 96" class="tn-obj" aria-hidden="true" focusable="false">
<rect x="6" y="66" width="138" height="26" rx="4" fill="var(--red)"/><rect x="118" y="70" width="22" height="18" rx="2" fill="var(--cream)"/>
<rect x="6" y="84" width="138" height="8" rx="3" fill="var(--red-deep)"/><rect x="24" y="66" width="8" height="26" fill="var(--gold)"/>
<rect x="18" y="40" width="116" height="26" rx="4" fill="var(--sea-deep)"/><rect x="108" y="44" width="22" height="18" rx="2" fill="var(--cream)"/>
<rect x="34" y="40" width="8" height="26" fill="var(--sky)"/>
<g transform="rotate(-3 76 26)"><rect x="12" y="14" width="124" height="26" rx="4" fill="var(--gold)"/><rect x="112" y="18" width="20" height="18" rx="2" fill="var(--cream)"/>
<rect x="12" y="32" width="124" height="8" rx="3" fill="var(--gold-deep)"/><rect x="28" y="14" width="8" height="26" fill="var(--red)"/></g></svg></div><div class="tn-layer " style="--d:22;bottom:43%;left:12%;width:28%" aria-hidden="true"><div class="tn-hop-idle"><Obj name="owl-prof" w="100%" /></div></div><div class="tn-layer " style="--d:20;bottom:16%;left:52%;width:17%" aria-hidden="true"><Obj name="flask" w="100%" class="tn-bubble" /></div><div class="tn-layer " style="--d:26;bottom:14%;right:4%;width:25%;--r:-14deg" aria-hidden="true"><div class="tn-tilted"><Obj name="magnifier" w="100%" /></div></div></div><div class="tn-layer tn-hide-sm" style="--d:18;top:33%;left:57%;width:10%" aria-hidden="true"><div class="tn-float"><Obj name="bee" w="100%" /></div></div><div class="tn-layer " style="--d:30;top:7%;right:6%;width:31%" aria-hidden="true"><svg class="tn-seal" viewBox="0 0 160 160" aria-hidden="true" focusable="false"><g fill="var(--red)"><circle cx="80" cy="80" r="68"/><circle cx="148.0" cy="80.0" r="11"/><circle cx="145.2" cy="99.2" r="11"/><circle cx="137.2" cy="116.8" r="11"/><circle cx="124.5" cy="131.4" r="11"/><circle cx="108.2" cy="141.9" r="11"/><circle cx="89.7" cy="147.3" r="11"/><circle cx="70.3" cy="147.3" r="11"/><circle cx="51.8" cy="141.9" r="11"/><circle cx="35.5" cy="131.4" r="11"/><circle cx="22.8" cy="116.8" r="11"/><circle cx="14.8" cy="99.2" r="11"/><circle cx="12.0" cy="80.0" r="11"/><circle cx="14.8" cy="60.8" r="11"/><circle cx="22.8" cy="43.2" r="11"/><circle cx="35.5" cy="28.6" r="11"/><circle cx="51.8" cy="18.1" r="11"/><circle cx="70.3" cy="12.7" r="11"/><circle cx="89.7" cy="12.7" r="11"/><circle cx="108.2" cy="18.1" r="11"/><circle cx="124.5" cy="28.6" r="11"/><circle cx="137.2" cy="43.2" r="11"/><circle cx="145.2" cy="60.8" r="11"/></g><circle cx="80" cy="80" r="60" fill="var(--cream)"/><g class="o-ring"><path id="tn-seal-ring" d="M80 80m-47 0a47 47 0 1 1 94 0a47 47 0 1 1-94 0" fill="none"/><text font-family="Instrument Sans, system-ui, sans-serif" font-weight="600" font-size="11.5" letter-spacing="1.2" fill="var(--red-deep)"><textPath href="#tn-seal-ring" textLength="292" lengthAdjust="spacing">COGNITIVE · BEHAVIOURAL · SCIENCE · </textPath></text></g><circle cx="80" cy="80" r="34" fill="var(--red)"/><g transform="translate(55.5 49.5) scale(.5)"><path d="M50 50C60 40 74 37 86 40L85 56C73 53 60 56 54.5 61V101.5A4.5 4.5 0 0 1 45.5 101.5V61C40 56 27 53 15 56L14 40C26 37 40 40 50 50Z" fill="var(--cream)"/></g></svg></div></div><div class="tn-trust__body"><h2 class="tn-h2" id="trust-h">Made by scientists, made for play.</h2><p class="tn-lead">Every Telning book is created by our team of cognitive and behavioural scientists.</p><ul class="tn-trust__pts"><li class="tn-trust__pt"><span class="tn-trust__ic" style="--c:var(--gold-light)" aria-hidden="true"><Obj name="signpost" w="100%" /></span><span><strong>Decision intelligence first</strong><span>The main focus of our scientists.</span></span></li><li class="tn-trust__pt"><span class="tn-trust__ic" style="--c:var(--sky)" aria-hidden="true"><Obj name="blocks" w="100%" /></span><span><strong>Four skills in every book</strong><span>Decision, emotional, social and behavioural.</span></span></li><li class="tn-trust__pt"><span class="tn-trust__ic" style="--c:var(--blush)" aria-hidden="true"><Obj name="book" w="100%" /></span><span><strong>Made for reading together</strong><span>The TADA way is based on dialogic reading.</span></span></li></ul><p class="tn-p"><a class="tn-link tn-link--solo" href="/about">{strings["trust.link"]}</a></p></div></section></div></div>

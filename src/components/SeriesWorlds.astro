---
import Obj from './Obj.astro';
/* SeriesWorlds: the twelve series as little paper worlds, the same cards as the "Our series" section on the home
   page. `only` keeps some series, `exclude` drops one (the series page shows "More series" this way). */
import WorldCard from "./WorldCard.astro";
interface Props { only?: string[]; exclude?: string; id?: string; class?: string }
const { only, exclude, id, class: cls = '' } = Astro.props;
const show = (k: string) => (!only || only.includes(k)) && k !== exclude;
---
<ul class={`tn-worlds ${cls}`} id={id}><WorldCard key="home-hearts" show={show}><span class="tn-world__scene" style="--c:var(--blush)" aria-hidden="true"><svg class="tn-world__far" viewBox="0 0 400 80" preserveAspectRatio="none" aria-hidden="true"><path d="M0 80V40C70 14 150 10 230 28s120 12 170-8v60z" fill="var(--cream)" opacity=".28"/></svg><div class="tn-world__o " style="left:8%;bottom:14%;width:46%"><Obj name="house" w="100%" /></div><div class="tn-world__o tn-hop" style="left:56%;bottom:12%;width:30%"><Obj name="cat" w="100%" /></div><div class="tn-world__o tn-float" style="left:72%;bottom:64%;width:15%"><Obj name="heart" w="100%" /></div><svg class="tn-world__ground" viewBox="0 0 400 60" preserveAspectRatio="none" aria-hidden="true"><path d="M0 60V26C60 8 130 2 200 14s140 18 200 4v42z" fill="var(--cream)"/></svg></span></WorldCard><WorldCard key="paws-claws" show={show}><span class="tn-world__scene" style="--c:var(--moss)" aria-hidden="true"><svg class="tn-world__far" viewBox="0 0 400 80" preserveAspectRatio="none" aria-hidden="true"><path d="M0 80V40C70 14 150 10 230 28s120 12 170-8v60z" fill="var(--cream)" opacity=".28"/></svg><div class="tn-world__o tn-hop" style="left:2%;bottom:10%;width:34%"><Obj name="fox" w="100%" /></div><div class="tn-world__o tn-hop" style="left:34%;bottom:10%;width:33%"><Obj name="bear" w="100%" /></div><div class="tn-world__o tn-hop" style="left:67%;bottom:10%;width:28%"><Obj name="bunny" w="100%" /></div><svg class="tn-world__ground" viewBox="0 0 400 60" preserveAspectRatio="none" aria-hidden="true"><path d="M0 60V26C60 8 130 2 200 14s140 18 200 4v42z" fill="var(--cream)"/></svg></span></WorldCard><WorldCard key="star-hoppers" show={show}><span class="tn-world__scene" style="--c:var(--sea-deep)" aria-hidden="true"><svg class="tn-world__far" viewBox="0 0 400 80" preserveAspectRatio="none" aria-hidden="true"><path d="M0 80V40C70 14 150 10 230 28s120 12 170-8v60z" fill="var(--cream)" opacity=".28"/></svg><div class="tn-world__o tn-float tn-flicker" style="left:8%;bottom:18%;width:17%"><Obj name="rocket" w="100%" /></div><div class="tn-world__o tn-float slow" style="left:34%;bottom:38%;width:46%"><Obj name="planet" w="100%" /></div><div class="tn-world__o tn-float late" style="left:74%;bottom:70%;width:17%"><Obj name="moon" w="100%" /></div><div class="tn-world__o tn-hop" style="left:68%;bottom:10%;width:22%"><Obj name="penguin" w="100%" /></div><svg class="tn-world__ground" viewBox="0 0 400 60" preserveAspectRatio="none" aria-hidden="true"><path d="M0 60V26C60 8 130 2 200 14s140 18 200 4v42z" fill="var(--cream)"/></svg></span></WorldCard><WorldCard key="little-gardeners" show={show}><span class="tn-world__scene" style="--c:var(--paper-deep)" aria-hidden="true"><svg class="tn-world__far" viewBox="0 0 400 80" preserveAspectRatio="none" aria-hidden="true"><path d="M0 80V40C70 14 150 10 230 28s120 12 170-8v60z" fill="var(--cream)" opacity=".28"/></svg><div class="tn-world__o " style="left:4%;bottom:12%;width:20%"><Obj name="tulip" w="100%" /></div><div class="tn-world__o " style="left:22%;bottom:12%;width:15%"><Obj name="tulip" w="100%" /></div><div class="tn-world__o tn-hop" style="left:42%;bottom:10%;width:34%"><Obj name="snail" w="100%" /></div><div class="tn-world__o tn-float" style="left:66%;bottom:56%;width:24%"><Obj name="bee" w="100%" /></div><svg class="tn-world__ground" viewBox="0 0 400 60" preserveAspectRatio="none" aria-hidden="true"><path d="M0 60V26C60 8 130 2 200 14s140 18 200 4v42z" fill="var(--cream)"/></svg></span></WorldCard><WorldCard key="big-days" show={show}><span class="tn-world__scene" style="--c:var(--gold-light)" aria-hidden="true"><svg class="tn-world__far" viewBox="0 0 400 80" preserveAspectRatio="none" aria-hidden="true"><path d="M0 80V40C70 14 150 10 230 28s120 12 170-8v60z" fill="var(--cream)" opacity=".28"/></svg><div class="tn-world__o tn-hop" style="left:8%;bottom:14%;width:34%"><Obj name="gift" w="100%" /></div><div class="tn-world__o tn-float" style="left:46%;b
12 170-8v60z" fill="var(--cream)" opacity=".28"/></svg><div class="tn-world__o tn-float" style="left:44%;bottom:46%;width:20%"><Obj name="ball" w="100%" /></div><div class="tn-world__o tn-hop" style="left:8%;bottom:10%;width:27%"><Obj name="bunny" w="100%" /></div><div class="tn-world__o tn-hop" style="left:64%;bottom:10%;width:29%"><Obj name="bear" w="100%" /></div><svg class="tn-world__ground" viewBox="0 0 400 60" preserveAspectRatio="none" aria-hidden="true"><path d="M0 60V26C60 8 130 2 200 14s140 18 200 4v42z" fill="var(--cream)"/></svg></span></WorldCard><WorldCard key="everyday-heroes" show={show}><span class="tn-world__scene" style="--c:var(--sea)" aria-hidden="true"><svg class="tn-world__far" viewBox="0 0 400 80" preserveAspectRatio="none" aria-hidden="true"><path d="M0 80V40C70 14 150 10 230 28s120 12 170-8v60z" fill="var(--cream)" opacity=".28"/></svg><div class="tn-world__o tn-float" style="left:6%;bottom:46%;width:22%"><Obj name="shield" w="100%" /></div><div class="tn-world__o tn-hop" style="left:32%;bottom:8%;width:42%"><Obj name="elephant" w="100%" /></div><div class="tn-world__o tn-float late" style="left:74%;bottom:52%;width:18%"><Obj name="owl" w="100%" /></div><svg class="tn-world__ground" viewBox="0 0 400 60" preserveAspectRatio="none" aria-hidden="true"><path d="M0 60V26C60 8 130 2 200 14s140 18 200 4v42z" fill="var(--cream)"/></svg></span></WorldCard><WorldCard key="on-the-move" show={show}><span class="tn-world__scene" style="--c:var(--sky-light)" aria-hidden="true"><svg class="tn-world__far" viewBox="0 0 400 80" preserveAspectRatio="none" aria-hidden="true"><path d="M0 80V40C70 14 150 10 230 28s120 12 170-8v60z" fill="var(--cream)" opacity=".28"/></svg><div class="tn-world__o tn-wheels" style="left:4%;bottom:12%;width:52%"><Obj name="car" w="100%" /></div><div class="tn-world__o tn-float" style="left:58%;bottom:62%;width:30%"><Obj name="plane" w="100%" /></div><div class="tn-world__o tn-float slow" style="left:66%;bottom:18%;width:24%"><Obj name="balloon" w="100%" /></div><svg class="tn-world__ground" viewBox="0 0 400 60" preserveAspectRatio="none" aria-hidden="true"><path d="M0 60V26C60 8 130 2 200 14s140 18 200 4v42z" fill="var(--cream)"/></svg></span></WorldCard></ul>

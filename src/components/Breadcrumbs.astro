---
/* Breadcrumbs on inner pages: Home › Page name (names from src/data/seo.json). The BreadcrumbList JSON-LD
   is rendered by Base.astro for the same path. */
import { crumbs } from '../lib/shop';
interface Props { page: string }
const { page } = Astro.props;
const chain = crumbs(page);
---
<nav class="tn-crumbs" aria-label="Breadcrumb"><ol>{chain.map((c, i) => i < chain.length - 1 ? <li><a href={c.path}>{c.name}</a></li> : <li><span aria-current="page">{c.name}</span></li>)}</ol></nav>

---
import SeriesWorlds from "./SeriesWorlds.astro";
import strings from "../data/strings.en.json";
---
<section class="tn-section" id="series" aria-labelledby="series-h"><div class="tn-wrap">
  <div class="tn-head tn-reveal"><h2 class="tn-h2" id="series-h" tabindex="-1">{strings["series.h2"]}</h2></div>
  <div class="tn-fold" data-fold><SeriesWorlds id="series-list" /><div class="tn-fold__fade" aria-hidden="true"></div></div><p class="tn-fold__more"><button class="tn-btn tn-btn--ghost" type="button" aria-controls="series-list" aria-expanded="false" data-fold-btn data-more={strings["series.more"]} data-less={strings["series.less"]}>{strings["series.more"]}</button></p>
</div></section>

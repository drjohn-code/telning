---
/* One product page, for every product (books, Story Walls, mugs, tote bags, postcards, greeting cards).
   The seven parts of the website plan, in order: 1 photos, 2 name, descriptor and price (with the scene line and a
   trust row), 3 choose, 4 keep the story going, 5 material and care, 6 delivery, 7 safety. Then "Keep the story going"
   (max 3 items) and "Complete the set". The buy form posts to /api/checkout without JavaScript; the shop script turns
   it into "Add to basket". No partner names anywhere on this page. */
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import Gallery from './Gallery.astro';
import Price from './Price.astro';
import ProductCard from './ProductCard.astro';
import Picture from './Picture.astro';
import TrustBar from './TrustBar.astro';
import GiftPicks from './GiftPicks.astro';
import CurrencySelect from './CurrencySelect.astro';
import PimNote from '../PimNote.astro';
import { catalog, shop, gifts, ageLabel, priceAttrs, giftPath, money, sceneLine, storyOf, deliveryWindow } from '../../lib/shop';

interface Props { p: any }
const { p } = Astro.props;
const HOST = 'https://telning.com';
const t = (shop.types as any)[p.type];
const isSeries = p.category === 'books';
const al = p.age ? ageLabel(p.age) : '';
const find = (sku: string) => catalog.bySku.get(sku) as any;

/* photos: alt text per view, describing the scene */
/* the Halloween gift photos (table, home, hand): the place and what is printed on it */
const giftAlt = (p: any, view: string) => {
  const what = p.design?.line ? `: ${p.design.line.replace(/\.$/, '').replace(/^./, (c: string) => c.toLowerCase())}` : '';
  const n = p.type === 'postcards' ? `the ${p.title} postcard` : p.type === 'cards' ? `the ${p.title} greeting card` : `the ${p.name}`;
  const at = {
    mug: { table: 'on a light oak table with a small pumpkin', home: 'with hot cocoa on a side table by the sofa', hand: 'held by its handle' },
    tote: { table: 'lying flat on an oak table', home: 'on a wooden peg in the hallway, a book inside', hand: 'carried by its straps on an autumn street' },
    postcards: { table: 'on a desk with a pencil', home: 'on a windowsill at home', hand: 'held in a hand' },
    cards: { table: 'standing on a table with a white envelope', home: 'standing open on a shelf', hand: 'held in a hand with its white envelope' },
  } as Record<string, Record<string, string>>;
  return `${n.charAt(0).toUpperCase()}${n.slice(1)} ${at[p.type]?.[view] || ''}${what}`.replace(/\s+/g, ' ').trim();
};
const ALT: Record<string, (p: any) => string> = {
  table: (p) => p.animal ? giftAlt(p, 'table') : `“${p.title}”, the ${p.seriesName} colouring book, on a light oak kitchen table with three crayons and a plant`,
  home: (p) => giftAlt(p, 'home'),
  hand: (p) => giftAlt(p, 'hand'),
  cover: (p) => `Front cover of “${p.title}”: Telning green, the ${p.seriesName} scene in a window, Pim in the corner, ages ${al}`,
  spread: (p) => `The book open: the conversation guide on the left page, a black-and-white drawing to colour on the right`,
  'last-page': () => `The empty last page, where your child draws the ending`,
  back: () => `Back cover with the story in six languages, the age and page badges and the QR code`,
  wall: (p) => `The ${p.seriesName} Story Wall coloured in and framed in light oak on a child’s bedroom wall`,
  progress: (p) => `The ${p.seriesName} Story Wall half coloured on a table, crayons around it`,
  detail: (p) => p.type === 'poster' ? `Close-up of the edge between the printed colour and the open line art, with the paper texture` : p.type === 'tote' ? `Close-up of the print on the organic cotton weave` : p.type === 'mug' ? `Close-up of the print on the glazed ceramic` : `Close-up of the matte card and its texture`,
  scale: (p) => p.type === 'poster' ? `The Story Wall on a wall next to a child’s chair: 100 cm wide` : `The ${p.title} mug next to a Telning book, to show the size`,
  art: (p) => `The whole ${p.seriesName} Story Wall picture: about a third in flat colour, the rest to colour`,
  breakfast: (p) => `The ${p.title} mug on a breakfast table in morning light, next to an open Telning book`,
  white: (p) => `The white ${p.title} mug`,
  colour: (p) => `The ${p.title} mug with a ${p.design.inside.toLowerCase()} inside and handle`,
  hook: (p) => `The ${p.title} tote bag on an oak hook, a Telning book peeking out`,
  natural: (p) => `The ${p.title} tote bag in undyed organic cotton`,
  black: (p) => `The ${p.title} tote bag in black organic cotton`,
  bench: (p) => `The ${p.title} tote bag on a park bench`,
  desk: (p) => `A written “${p.title}” postcard on a desk with a pen, the front beside it`,
  front: (p) => p.type === 'postcards' ? `The front of the “${p.title}” postcard` : `The front of the “${p.title}” greeting card`,
  pack: (p) => p.type === 'postcards' ? `The pack of ten “${p.title}” postcards` : `Ten “${p.title}” cards and ten envelopes`,
  flatlay: (p) => `The “${p.title}” card with its envelope on linen`,
  open: (p) => `The “${p.title}” card open: blank inside for your own words`,
};
const images = p.images.map((im: any) => ({ ...im, alt: (ALT[im.view] || (() => p.name))(p), zoom: p.type === 'poster' && im.view === 'art' }));

/* the age and format switches for books and Story Walls */
const sibling = (type: string, age: string) => find(`${type}-${p.series}-${age}`);
const keepBook = isSeries ? find(`book-${p.series}-${p.age}`) : p.story ? find(`book-${p.story.series}-3-5`) : null;
const keepLine = isSeries ? p.book.keep : null;

/* Complete the set: for books and Story Walls the other format and the other age of the same series; for gifts, more of
   the same kind. The gift band at the end (GiftPicks) shows a tote bag, a mug and a Story Wall. */
let more: any[] = [];
if (p.type === 'book') more = [sibling('poster', p.age), sibling('book', p.age === '3-5' ? '5-7' : '3-5'), sibling('poster', p.age === '3-5' ? '5-7' : '3-5')];
else if (p.type === 'poster') more = [sibling('book', p.age), sibling('poster', p.age === '3-5' ? '5-7' : '3-5'), sibling('book', p.age === '3-5' ? '5-7' : '3-5')];
else more = [...catalog.products.filter((x: any) => x.type === p.type && x.sku !== p.sku).slice(0, 4), ...(keepBook ? [keepBook] : [])].slice(0, 4);
more = more.filter(Boolean);

/* product structured data */
const priceOf = (x: any) => ((x.variants ? x.variants[0].price : x.price).EUR / 100).toFixed(2);
const ld: Record<string, unknown> = {
  '@type': p.type === 'book' ? ['Product', 'Book'] : 'Product',
  '@id': `${HOST}${p.url}#product`, name: p.name, sku: p.sku, url: `${HOST}${p.url}`,
  image: p.images.map((im: any) => `${HOST}${im.src}-1200.webp`),
  description: p.type === 'book' ? `${p.book.hook} ${p.book.story}` : p.type === 'poster' ? `${p.seriesName} Story Wall: a large colouring picture for the wall, 100 × 70 cm. ${p.poster.scene}` : `${sceneLine(p)} ${p.design.about}`,
  brand: { '@type': 'Brand', name: 'Telning' }, manufacturer: { '@id': `${HOST}/#organization` },
  category: p.category === 'books' ? 'Books & posters' : 'Gifts',
  material: p.type === 'tote' ? 'GOTS-certified organic cotton' : p.type === 'mug' ? 'Glazed ceramic' : p.type === 'poster' ? 'Matte paper, 189 g/m²' : 'FSC-certified paper',
  ...(p.type === 'book' ? { bookFormat: 'https://schema.org/Paperback', numberOfPages: 32, author: { '@id': `${HOST}/#organization` }, publisher: { '@id': `${HOST}/#organization` }, typicalAgeRange: p.age, alternateName: `${p.seriesName} colouring book, ages ${al}` } : {}),
  ...(p.type === 'poster' ? { alternateName: `${p.seriesName} Story Wall, ages ${al}`, size: '100 × 70 cm' } : {}),
  ...(p.age ? { audience: { '@type': 'PeopleAudience', suggestedMinAge: Number(p.age.split('-')[0]), suggestedMaxAge: Number(p.age.split('-')[1]) } } : {}),
  offers: {
    '@type': 'Offer', url: `${HOST}${p.url}`, price: priceOf(p), priceCurrency: 'EUR', availability: 'https://schema.org/InStock', itemCondition: 'https://schema.org/NewCondition',
    seller: { '@id': `${HOST}/#organization` },
    shippingDetails: { '@type': 'OfferShippingDetails', shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'SE' }, deliveryTime: { '@type': 'ShippingDeliveryTime', handlingTime: { '@type': 'QuantitativeValue', minValue: 1, maxValue: 4, unitCode: 'DAY' }, transitTime: { '@type': 'QuantitativeValue', minValue: 2, maxValue: 6, unitCode: 'DAY' } } },
    hasMerchantReturnPolicy: { '@type': 'MerchantReturnPolicy', applicableCountry: 'SE', returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow', merchantReturnDays: 14, returnMethod: 'https://schema.org/ReturnByMail', returnFees: 'https://schema.org/ReturnShippingFees' },
  },
};
const taxAttrs = Object.fromEntries(Object.entries(shop.currencies).map(([c, v]: [string, any]) => [`data-taxnote-${c.toLowerCase()}`, v.taxNote]));
const firstShip = (shop.parcels as any)[p.parcel].first;
const shipAttrs = Object.fromEntries(Object.entries(firstShip).map(([c, v]) => [`data-${c.toLowerCase()}`, money(Math.round((v as number) * 100), c, (shop.currencies as any)[c].locale)]));
const windows = deliveryWindow();
const winAttrs = Object.fromEntries(Object.entries(windows).map(([c, v]) => [`data-${c.toLowerCase()}`, v]));
const h1 = p.name;
const sub = p.descriptor;
const story = storyOf(p);
const pimLine = p.type === 'book' ? 'I can’t wait to see which ending you choose.' : p.type === 'poster' ? 'Can you find me on the wall?' : null;
const cert = p.type === 'tote' ? 'GOTS · OEKO-TEX' : p.type === 'mug' ? 'Dishwasher safe' : p.type === 'poster' ? 'Acid-free matte paper' : p.type === 'postcards' ? 'FSC/PEFC-certified paper' : 'FSC-certified paper';
---
<Base page={p.url} jsonld={[ld]} preload={{ src: images[0].src }}>
  <Header />
  <main id="main" tabindex="-1">
    <div class="tn-wrap"><Breadcrumbs page={p.url} /></div>
    <section class="tn-wrap tn-pdp" aria-labelledby="page-h" data-type={p.type}>
      <div class="tn-pdp__gallery"><Gallery images={images} /></div>

      <div class="tn-pdp__info">
        <h1 class="tn-pdp__h1" id="page-h" tabindex="-1">{h1}</h1>
        <p class="tn-pdp__sub">{sub}</p>
        <p class="tn-pdp__story">{story}</p>
        {(keepLine || p.story) && (
          <p class="tn-pdp__from">
            {isSeries
              ? <>From the book <a href={keepBook.url}><em>{p.book.title}</em></a>: {keepLine}.</>
              : <>A cousin of the book <a href={`/books/${p.story.series}`}><em>{p.story.seriesName}</em></a>.</>}
          </p>
        )}
        <div class="tn-pdp__pricerow">
          <p class="tn-pdp__price"><Price p={p} class="tn-pdp__amount" /><span class="tn-pdp__tax" {...taxAttrs}>Price includes VAT.</span></p>
          <ul class="tn-trustrow" aria-label="Our promises">
            <li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>Secure payment</li>
            <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 3-6.2M4 4v4h4"/></svg>14-day returns</li>
            <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v6c0 5-3.5 8-7 9-3.5-1-7-4-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>{cert}</li>
          </ul>
        </div>
        <p class="tn-pdp__delivery"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg><span>Made for you after you order. Order today and it arrives <strong class="tn-price" {...winAttrs}>{winAttrs['data-eur']}</strong>.</span></p>
        {p.regions && <p class="tn-pdp__regions">Delivered to Europe and the UK only. Not available in the US and Canada.</p>}
        <p class="tn-pdp__shipfrom">Shipping from <span class="tn-price" {...shipAttrs}>{shipAttrs['data-eur']}</span> per parcel. <a class="tn-link" href="/shipping-returns">Shipping &amp; returns</a></p>

        {p.soon ? (
          <div class="tn-note tn-note--sky tn-pdp__soon"><h3 class="tn-h3">Coming soon</h3><p class="tn-p">The pictures of this design are on their way. You cannot order it yet.</p></div>
        ) : (
        <form class="tn-buy" method="post" action="/api/checkout" data-sku={p.sku} data-max={p.maxQty}>
          <input type="hidden" name="sku" value={p.sku} />
          <input type="hidden" name="currency" value="EUR" />
          {isSeries && (
            <>
              <fieldset class="tn-opt"><legend>Age</legend><div class="tn-opt__row">
                {['3-5', '5-7'].map((a) => { const x = sibling(p.type, a); return <a class={`tn-chip${a === p.age ? ' is-on' : ''}`} href={x.url} aria-current={a === p.age ? 'page' : undefined}>Ages {ageLabel(a)}</a>; })}
                <span class="tn-chip is-off" aria-disabled="true">Ages 1–3 <small>coming soon</small></span>
              </div></fieldset>
              <fieldset class="tn-opt"><legend>Format</legend><div class="tn-opt__row">
                {['book', 'poster'].map((ty) => { const x = sibling(ty, p.age); return <a class={`tn-chip${ty === p.type ? ' is-on' : ''}`} href={x.url} aria-current={ty === p.type ? 'page' : undefined}>{ty === 'book' ? 'Colouring book' : 'Story Wall'}</a>; })}
              </div></fieldset>
            </>
          )}
          {p.variants && p.variants.length === 1 && (
            <p class="tn-opt__fixed"><span class="tn-opt__k">{p.variantLabel}</span>{p.type === 'tote' && <span class="tn-swatch" style={`--sw:${p.variants[0].key === 'black' ? '#1d1c1a' : '#efe6d4'}`} aria-hidden="true"></span>}{p.variants[0].name}<input type="radio" name="variant" value={p.variants[0].key} checked hidden /></p>
          )}
          {p.variants && p.variants.length > 1 && (
            <fieldset class="tn-opt"><legend>{p.variantLabel}</legend><div class="tn-opt__row">
              {p.variants.map((v: any, i: number) => (
                <label class="tn-chip tn-chip--radio"><input type="radio" name="variant" value={v.key} checked={i === 0} data-view={v.key} {...priceAttrs(p, v.key)} />
                  {p.type === 'mug' && <span class="tn-swatch" style={`--sw:${v.key === 'white' ? '#fff' : p.design.insideHex}`} aria-hidden="true"></span>}
                  {p.type === 'tote' && <span class="tn-swatch" style={`--sw:${v.key === 'black' ? '#1d1c1a' : '#efe6d4'}`} aria-hidden="true"></span>}
                  {v.name}{p.type === 'mug' && v.key === 'colour' ? ` (${p.design.inside.toLowerCase()})` : ''}</label>
              ))}
            </div></fieldset>
          )}
          <div class="tn-buy__row">
            <div class="tn-qty tn-qty--big" role="group" aria-label="Quantity">
              <button class="tn-qty__b" type="button" data-step="-1" aria-label="One less">−</button>
              <input class="tn-qty__in" type="number" name="qty" value="1" min="1" max={p.maxQty} inputmode="numeric" aria-label="Quantity" />
              <button class="tn-qty__b" type="button" data-step="1" aria-label="One more">+</button>
            </div>
            <button class="tn-btn tn-btn--buy" type="submit">Add to basket</button>
          </div>
          <CurrencySelect id="cur-pdp" class="tn-buy__cur" />
        </form>
        )}

        <dl class="tn-pdp__specs" aria-label="Details">{t.specs.map(([k, v]: [string, string]) => <div class="tn-pdp__spec"><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
        {pimLine && <PimNote line={pimLine} size="sm" class="tn-pdp__pim" />}
      </div>
    </section>

    <section class="tn-wrap tn-pdp__more" aria-label="About this product">
      <div class="tn-pdp__text">
        {p.type === 'book' && (
          <details class="tn-details" open>
            <summary>The story</summary>
            <div class="tn-prose">
              <p class="tn-lead">{p.book.hook}</p>
              <p>{p.book.story}</p>
              <p><strong>Then your child decides:</strong> {p.book.choice}</p>
              <ul class="tn-endings">{p.book.endings.map((e: string, i: number) => <li><span>Ending {i + 1}</span>{e}</li>)}<li><span>Or</span>your child draws a new ending on the last page.</li></ul>
              <p class="tn-small">The pictures tell the story without words, so every child can join in, whatever language they speak at home.</p>
            </div>
          </details>
        )}
        {p.type === 'book' && (
          <details class="tn-details" open>
            <summary>What is inside</summary>
            <div class="tn-prose">
              <ul>{t.inside.map((x: string) => <li>{x}</li>)}</ul>
              <p>From the conversation guide:</p>
              <ul class="tn-talk">{p.book.talk.map((x: string) => <li>“{x}”</li>)}</ul>
              <p>Every drawing inside is black-and-white line art, made for pencils and crayons. The photos above show the real pages: the guide on the left, the drawing on the right, and the empty last page.</p>
            </div>
          </details>
        )}
        {p.type === 'poster' && (
          <details class="tn-details" open>
            <summary>The picture</summary>
            <div class="tn-prose">
              <p class="tn-lead">{p.poster.scene}</p>
              <p>{p.age === '3-5' ? 'For ages 3–5 the shapes are big and the outlines are thick, so small hands can stay inside them with a crayon.' : 'For ages 5–7 the shapes are smaller and there is more to find and count, for steady hands and long afternoons.'} About a third of the picture is printed in flat Telning colours, spread over the sheet to guide your child’s own colour choices. The rest is clear line art, waiting to be coloured. Somewhere in the picture, Pim is hiding.</p>
              <p>It is the world of <a href={`/books/${p.series}`}>{p.seriesName}</a>, the series of the book <a href={keepBook.url}>“{p.book.title}”</a>. Colour it alone or with friends, over many days. Then put it in a 70 × 100 cm frame and hang it: it is wall art first.</p>
            </div>
          </details>
        )}
        {!isSeries && (
          <details class="tn-details" open>
            <summary>The design</summary>
            <div class="tn-prose">
              <p class="tn-lead">{p.design.about}</p>
              <p>{p.type === 'mug' ? 'One small scene on a white glazed mug, white inside and out.' : p.type === 'tote' ? 'One small print on the front of the bag, in undyed or black organic cotton. The back is plain.' : p.type === 'postcards' ? 'Ten postcards of this one design in a pack. The back has a line for your message, an address box and a small Telning colophon.' : 'Ten folded cards of this one design in a pack, with ten envelopes. Blank inside, so the words are yours. A small Telning colophon on the back.'}</p>
              <p>Designed in Sweden by Telning Publishing House. Made for you, with care.</p>
            </div>
          </details>
        )}
        <details class="tn-details">
          <summary>Material and care</summary>
          <div class="tn-prose"><p>{t.materials}</p><p>{t.care}</p><p><a href="/materials">Our materials and certificates</a></p></div>
        </details>
        <details class="tn-details">
          <summary>Delivery and returns</summary>
          <div class="tn-prose"><p>{shop.delivery}</p><p>{shop.separateParcel}</p><p><a href="/shipping-returns">Shipping &amp; returns</a></p></div>
        </details>
        <details class="tn-details">
          <summary>Safety</summary>
          <div class="tn-prose"><p>{t.safety}</p>{p.age && <p>Made for children aged {al}, with a grown-up nearby.</p>}</div>
        </details>
      </div>

    </section>


    <section class="tn-section tn-section--tight" aria-labelledby="more-h"><div class="tn-wrap">
      <div class="tn-head"><h2 class="tn-h2 tn-h2--s" id="more-h">{isSeries ? 'Complete the set' : `More ${t.plural.toLowerCase()}`}</h2></div>
      <ul class="tn-pgrid tn-pgrid--4">{more.map((x: any) => <ProductCard p={x} />)}</ul>
      <p class="tn-p" style="margin-top:var(--s5)">{isSeries ? <a class="tn-link tn-link--solo" href={`/books/${p.series}`}>Everything in {p.seriesName}</a> : <a class="tn-link tn-link--solo" href={giftPath(p.type)}>All {t.plural.toLowerCase()}</a>}</p>
    </div></section>

    <GiftPicks series={isSeries ? p.series : undefined} age={p.age || '3-5'} not={p.sku} />

    <section class="tn-section tn-section--tight" aria-label="Our promises"><div class="tn-wrap"><TrustBar /></div></section>

    {!p.soon && (
    <div class="tn-buybar" aria-hidden="true">
      <span class="tn-buybar__name">{h1}</span>
      <Price p={p} class="tn-buybar__price" />
      <button class="tn-btn tn-btn--buy" type="button" tabindex="-1" data-buybar>Add to basket</button>
    </div>
    )}
  </main>
  <Footer />
</Base>

---
/* Three quiet promises (shop.json `trust`), each claim with its proof on Our materials. */
import { shop } from '../../lib/shop';
const IC = [
  '<path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  '<path d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6z"/><path d="M9 12l2 2 4-4"/>',
  '<path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.3 1 2.3h6c0-1 .4-1.8 1-2.3A7 7 0 0 0 12 2z"/>',
];
---
<ul class="tn-trustbar">{shop.trust.map((x: any, i: number) => (<li><svg viewBox="0 0 24 24" aria-hidden="true" set:html={IC[i]}></svg><span><strong>{x.h}</strong> {x.t}</span></li>))}</ul>
<p class="tn-trustbar__more"><a class="tn-link" href="/materials">Our materials</a> · <a class="tn-link" href="/shipping-returns">Shipping &amp; returns</a></p>

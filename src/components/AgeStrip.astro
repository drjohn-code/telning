---
/* AgeStrip: the quiet way in by age. An age card links to /books?age=<key> when the shop has books and posters
   for that age. Until then it is a plain card with the "Coming soon" pill (1–3 for now). */
import site from '../data/site-data.json';
import strings from '../data/strings.en.json';
import Obj from './Obj.astro';

const ART: Record<string, { animal: string; c: string }> = {
  '1-3': { animal: 'duck', c: 'blush' },
  '3-5': { animal: 'bunny', c: 'sky' },
  '5-7': { animal: 'owl', c: 'gold-light' },
};
import { catalog } from '../lib/shop';
/* An age links to the shop (Books & posters, filtered by age) when the shop has products for it. 1–3 stays "Coming soon". */
const outAges = new Set(catalog.products.filter((p: any) => p.age).map((p: any) => p.age));
---
<section class="tn-wrap tn-agesec" aria-labelledby="ages-h" id="ages"><div class="tn-ages"><h2 class="tn-ages__h" id="ages-h" tabindex="-1">{strings['ages.h2']}</h2><ul class="tn-agestrip">{site.ages.map((a) => {
  const out = outAges.has(a.key);
  const art = ART[a.key] || { animal: 'bunny', c: 'sky' };
  const inner = (
    <>
      <span class="tn-agechip__n" aria-hidden="true">{a.label}</span>
      <span class="tn-agechip__t"><span class="tn-agechip__l">{a.name}<span class="tn-sr">, ages {a.label}</span></span>{!out && <span class="tn-pill tn-pill--soft tn-agechip__pill"><span class="tn-sr">, </span>{strings['series.coming']}</span>}</span>
      <span class="tn-agechip__obj" aria-hidden="true"><Obj name={art.animal} w="100%" /></span>
    </>
  );
  return (
    <li>{out
      ? <a class="tn-agechip tn-agechip--link tn-reveal" href={`/books?age=${a.key}`} style={`--c:var(--${art.c})`}>{inner}</a>
      : <div class="tn-agechip tn-agechip--soon tn-reveal" style={`--c:var(--${art.c})`}>{inner}</div>}
    </li>
  );
})}</ul></div></section>

---
/* AgeStrip: the quiet way in by age. The groups are `ages` in site-data.json (John, 15 Oct 2026: 1–3 Toddler,
   3–7 Preschool, 7+ School and Adults; the key of Adults stays `young-adults`). An age card links to /books?age=<key>
   when a product on sale answers to that group; until then it is a plain card with the "Coming soon" pill (1–3 and
   Adults for now). Adults has no number, only its name. */
import site from '../data/site-data.json';
import strings from '../data/strings.en.json';
import Obj from './Obj.astro';

const ART: Record<string, { animal: string; c: string }> = {
  '1-3': { animal: 'duck', c: 'blush' },
  '3-7': { animal: 'bunny', c: 'sky' },
  '7+': { animal: 'owl', c: 'gold-light' },
  'young-adults': { animal: 'fox', c: 'sea' },
};
import { catalog, ageGroupsOf } from '../lib/shop';
/* An age links to the shop (filtered by that group) when a product on sale answers to it. */
const outAges = new Set(catalog.products.filter((p: any) => !p.hidden).flatMap((p: any) => ageGroupsOf(p)));
---
<section class="tn-wrap tn-agesec" aria-labelledby="ages-h" id="ages"><div class="tn-ages"><h2 class="tn-ages__h" id="ages-h" tabindex="-1">{strings['ages.h2']}</h2><ul class="tn-agestrip">{site.ages.map((a) => {
  const out = outAges.has(a.key);
  const art = ART[a.key] || { animal: 'bunny', c: 'sky' };
  const inner = (
    <>
      {a.label && <span class="tn-agechip__n" aria-hidden="true">{a.label}</span>}
      <span class="tn-agechip__t"><span class="tn-agechip__l">{a.name}{a.label && <span class="tn-sr">, ages {a.label}</span>}</span>{!out && <span class="tn-pill tn-pill--soft tn-pill--soon tn-agechip__pill"><span class="tn-sr">, </span>{strings['series.coming']}</span>}</span>
      <span class="tn-agechip__obj" aria-hidden="true"><Obj name={art.animal} w="100%" /></span>
    </>
  );
  return (
    <li>{out
      ? <a class="tn-agechip tn-agechip--link tn-reveal" href={`/books?age=${encodeURIComponent(a.key)}`} style={`--c:var(--${art.c})`}>{inner}</a>
      : <div class="tn-agechip tn-agechip--soon tn-reveal" style={`--c:var(--${art.c})`}>{inner}</div>}
    </li>
  );
})}</ul></div></section>

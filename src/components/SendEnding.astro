---
import Obj from './Obj.astro';
import KidDrawing from "./KidDrawing.astro";
---
<section class="tn-section" aria-labelledby="send-h"><div class="tn-wrap tn-send">
  <div class="tn-reveal" style="display:grid;gap:16px"><h2 class="tn-h2" id="send-h">Send Pim your ending</h2><p class="tn-lead">Your child chooses the ending. Tell Pim about it, and Pim writes back with a story card and ideas for your next talk.</p><p class="tn-p"><a class="tn-link tn-link--solo" href="/send">Tell Pim your ending</a></p></div>
  <div class="tn-send__art tn-scene" data-depth-area>
    <div class="tn-slot tn-slot--4x5 tn-send__card" aria-hidden="true"><KidDrawing /></div>
    <div class="tn-layer " style="--d:30;top:-14%;right:-14%;width:34%" aria-hidden="true"><div class="tn-float slow"><Obj name="balloon" w="100%" class="tn-sway" /></div></div>
    <div class="tn-layer " style="--d:40;bottom:6%;left:-22%;width:40%" aria-hidden="true"><div class="tn-float"><Obj name="plane" w="100%" /></div></div>
  </div>
</div></section>
